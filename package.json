{
  "name": "pi-resume",
  "version": "1.6.0",
  "description": "Fast session resume for pi coding agent — /r1,/r2 ranked resume, /rn and /rp step navigation, pi-r launcher (resume before pi starts), /rs paginated picker, /rds subagent session cleanup; skips sessions open in other pi instances, tidies legacy subagent forks",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "session",
    "resume"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/axelbaumlisto/pi-fast-resume.git"
  },
  "bin": {
    "pi-r": "bin/pi-r.mjs"
  },
  "files": [
    "bin",
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --test tests/*.test.ts",
    "check": "npm run typecheck && npm pack --dry-run",
    "prepublishOnly": "npm run check",
    "test:tui": "node --experimental-vm-modules --test tests/tui/tui.test.ts"
  }
}
